# ------------------------------------------------------------------
# Copy this file to `.env.local` and fill in your own values.
# NEVER commit `.env.local` or paste these keys into chat / git.
# Find these in your Supabase project → Settings → API.
# ------------------------------------------------------------------

# Safe to expose to the browser (public).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SERVER ONLY. Full-access key — never expose to the browser, never commit.
# Used by server actions (officer/nodal reads) and scripts/seed.mjs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Demo speed dial: how many real seconds represent one "SLA day".
#   86400 = real calendar time (1 day = 1 day)
#   1     = 1 second per day  -> a 30-day SLA breaches in 30s on stage
# Great for the live "deemed approval fires on stage" moment.
NEXT_PUBLIC_SLA_SECONDS_PER_DAY=1

# API Keys for Live Official FSSAI Verification (Instantpay)
INSTANTPAY_CLIENT_ID=
INSTANTPAY_CLIENT_SECRET=
INSTANTPAY_AUTH_CODE=
