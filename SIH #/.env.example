# ============================================================
# SIH 2026 — Environment Variables Template
# Copy this file to .env (never commit .env to git)
# ============================================================

# Supabase
SUPABASE_URL=https://ngbavxuirjhzaatdniyp.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Gemini API (backend only — never expose to frontend)
GEMINI_API_KEY=<your-gemini-api-key>

# Backend API
API_PORT=3001
API_BASE_URL=http://localhost:3001
NODE_ENV=development

# Frontend
VITE_SUPABASE_URL=https://ngbavxuirjhzaatdniyp.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>
VITE_API_BASE_URL=http://localhost:3001

# Demo Mode (true = show DEMO DATA labels, false = LIVE mode)
VITE_DEMO_MODE=true

# Government Connectors (leave blank if credentials not available)
MAITRI_API_KEY=
NSWS_API_KEY=
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
GST_NIC_API_KEY=
UDYAM_API_KEY=
